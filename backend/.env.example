# Copie este arquivo para ".env" e preencha com os dados do SEU MySQL local
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=bibliomusic

# Porta em que o servidor Express vai rodar
PORT=3001

# Chave secreta usada para assinar os tokens JWT (pode ser qualquer string longa)
JWT_SECRET=troque_esta_string_por_algo_bem_secreto

# Endereços do front que podem chamar a API (separados por vírgula)
CORS_ORIGIN=http://localhost:5173

# Só em produção: certificado CA do Aiven (deixe vazio localmente)
DB_CA_CERT=